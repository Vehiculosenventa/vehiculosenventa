<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🏠 Mis Vehículos — Vehículos en Venta</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    * {box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, sans-serif;}
    body {
      background: linear-gradient(135deg, #91b8d5 0%, #7aa7c9 100%);
      padding: 20px;
      min-height: 100vh;
    }
    .contenedor {max-width: 920px; margin: 0 auto;}

    .barra-superior {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      padding-bottom: 12px;
      border-bottom: 2px solid rgba(44, 82, 130, 0.15);
    }
    .zona-izquierda {
      font-weight: 700;
      font-size: 14px;
      min-width: 120px;
    }
    .zona-izquierda.conectado {color: #166534;}
    .zona-izquierda.desconectado {color: #dc2626;}
    .titulo-pagina {
      font-size: 22px;
      font-weight: 800;
      color: #2c5282;
      text-align: center;
      flex: 1;
    }
    .zona-derecha {
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      text-decoration: none;
      min-width: 120px;
      text-align: right;
    }
    .zona-derecha:hover {text-decoration: underline;}
    .boton-conectar {color: #1d4ed8;}
    .boton-cerrar {color: #dc2626;}

    .fila-dos-columnas {
      display: flex;
      gap: 20px;
      width: 100%;
    }
    .columna-vertical {
      width: 50%;
      background: linear-gradient(135deg, #d9c9ad 0%, #c9b58a 100%);
      padding: 20px;
      border-radius: 16px;
      border: 1px solid #bfa980;
      min-height: 400px;
    }
    .columna-vertical h2 {
      text-align: center;
      font-size: 18px;
      margin-bottom: 18px;
      padding-bottom: 10px;
      border-bottom: 2px solid #d4c29c;
      color: #2c5282;
    }

    .tarjeta-chica {
      background: white;
      padding: 14px;
      border-radius: 10px;
      margin-bottom: 12px;
      border-left: 4px solid #bfa980;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tarjeta-chica:hover {
      transform: translateX(4px);
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .tarjeta-chica h3 {
      font-size: 15px;
      color: #2c5282;
      margin-bottom: 4px;
    }
    .tarjeta-chica p {
      font-size: 13px;
      color: #6b7280;
    }
    .quitar {
      background: #fee2e2;
      color: #dc2626;
      border: none;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      margin-top: 8px;
      cursor: pointer;
    }
    .quitar:hover {background: #fecaca;}

    .aviso-limite {
      background: #fef3c7;
      color: #92400e;
      padding: 10px;
      border-radius: 8px;
      font-size: 13px;
      margin-bottom: 15px;
      text-align: center;
      display: none;
    }
    .sin-datos {
      text-align: center;
      padding: 40px 20px;
      color: #78716c;
      font-size: 14px;
    }

    .volver {
      display: block;
      text-align: center;
      margin-top: 25px;
      color: #1e40af;
      text-decoration: none;
      font-weight: 600;
      padding: 12px;
      background: rgba(255,255,255,0.6);
      border-radius: 10px;
      transition: all 0.2s;
    }
    .volver:hover {background: #d7e6f2;}

    .cargando {
      text-align: center;
      padding: 40px;
      color: #2c5282;
      font-weight: 600;
    }

    @media (max-width: 650px) {
      .fila-dos-columnas {flex-direction: column;}
      .columna-vertical {width: 100%;}
    }
  </style>
</head>
<body>

  <div class="contenedor">
    <div class="barra-superior">
      <div class="zona-izquierda" id="zonaIzquierda"></div>
      <h1 class="titulo-pagina">🏠 MIS VEHÍCULOS</h1>
      <a href="#" class="zona-derecha" id="botonAccion"></a>
    </div>

    <div class="fila-dos-columnas">
      <!-- COLUMNA IZQUIERDA → VERTICAL → Publicados por él -->
      <div class="columna-vertical">
        <h2>🚗 Mis Publicados</h2>
        <div id="listaPublicados">
          <div class="cargando">🔄 Cargando...</div>
        </div>
      </div>

      <!-- COLUMNA DERECHA → VERTICAL → Favoritos que marcó -->
      <div class="columna-vertical">
        <h2>⭐ Mis Favoritos (0/5)</h2>
        <div id="avisoLimite" class="aviso-limite">
          ⚠️ Llegaste al límite de 5 favoritos
        </div>
        <div id="listaFavoritos">
          <div class="cargando">🔄 Cargando...</div>
        </div>
      </div>
    </div>

    <a href="index.html" class="volver">← Volver a la página principal</a>
  </div>

  <script>
    const SUPABASE_URL = "https://uhdypavizwkkbygrvuex.supabase.co";
    const SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVoZHlwYXZizndra2J5Z3J2dWV4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzNTM5NTcsImV4cCI6MjEwNDkyOTk1N30.JnqXIEIfwTG74m8zaY3glL1TsNoyhJhkSZP9niowtps";

    let sbClient = null;
    let idUsuarioActual = null;

    async function getSupabase() {
      if (!sbClient) sbClient = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
      return sbClient;
    }

    async function verificarSesion() {
      const zonaIzq = document.getElementById('zonaIzquierda');
      const botonAccion = document.getElementById('botonAccion');
      const sb = await getSupabase();
      const { data: { session } } = await sb.auth.getSession();
      const correo = localStorage.getItem('correo_usuario') || localStorage.getItem('correo');
      const haySesion = !!(session || correo);

      if (haySesion) {
        zonaIzq.textContent = "✅ Conectado";
        zonaIzq.className = "zona-izquierda conectado";
        botonAccion.textContent = "Cerrar sesión";
        botonAccion.className = "zona-derecha boton-cerrar";
        botonAccion.onclick = async (e) => {
          e.preventDefault();
          await cerrarSesion();
        };
        const { data: usuario } = await sb.from('usuarios').select('id').eq('correo', correo).single();
        idUsuarioActual = usuario?.id;
      } else {
        zonaIzq.textContent = "❌ Desconectado";
        zonaIzq.className = "zona-izquierda desconectado";
        botonAccion.textContent = "Conectar";
        botonAccion.className = "zona-derecha boton-conectar";
        botonAccion.onclick = (e) => {
          e.preventDefault();
          window.location.href = 'iniciar-sesion.html';
        };
      }
      return haySesion;
    }

    async function cerrarSesion() {
      const sb = await getSupabase();
      await sb.auth.signOut();
      localStorage.clear();
      window.location.href = 'index.html';
    }

    async function cargarPublicados() {
      const caja = document.getElementById('listaPublicados');
      const correo = localStorage.getItem('correo_usuario') || localStorage.getItem('correo');
      if (!correo) {
        caja.innerHTML = `<div class="sin-datos">🔐 Iniciá sesión para ver tus publicados</div>`;
        return;
      }
      const sb = await getSupabase();
      const { data, error } = await sb
        .from('autos')
        .select('id, marca, modelo, anio, ciudad')
        .eq('correo', correo)
        .order('id', { ascending: false });

      if (error) {
        caja.innerHTML = `<div class="sin-datos">❌ Error: ${error.message}</div>`;
        return;
      }
      if (!data.length) {
        caja.innerHTML = `<div class="sin-datos">📭 Aún no publicaste ningún vehículo</div>`;
        return;
      }
      caja.innerHTML = data.map(v => `
        <div class="tarjeta-chica" onclick="verDetalle(${v.id})">
          <h3>${v.marca||''} ${v.modelo||''}</h3>
          <p>${v.anio||''} · ${v.ciudad||''}</p>
        </div>
      `).join('');
    }

    async function cargarFavoritos() {
      const caja = document.getElementById('listaFavoritos');
      const titulo = document.querySelector('.columna-vertical:nth-child(2) h2');
      const aviso = document.getElementById('avisoLimite');
      if (!idUsuarioActual) {
        caja.innerHTML = `<div class="sin-datos">⭐ Iniciá sesión para ver favoritos</div>`;
        titulo.textContent = `⭐ Mis Favoritos (0/5)`;
        return;
      }
      const sb = await getSupabase();
      const { data: guardados, error } = await sb
        .from('mis_vehiculos')
        .select('id, vehiculo_id')
        .eq('usuario_id', idUsuarioActual)
        .limit(5);

      if (error) {
        caja.innerHTML = `<div class="sin-datos">❌ Error: ${error.message}</div>`;
        return;
      }
      const cant = guardados ? guardados.length : 0;
      titulo.textContent = `⭐ Mis Favoritos (${cant}/5)`;
      aviso.style.display = cant >= 5 ? 'block' : 'none';
      if (!cant) {
        caja.innerHTML = `<div class="sin-datos">⭐ Aún no guardaste favoritos</div>`;
        return;
      }
      const ids = guardados.map(g => g.vehiculo_id);
      const { data: vehiculos } = await sb
        .from('autos')
        .select('id, marca, modelo, anio, ciudad')
        .in('id', ids);

      if (!vehiculos || !vehiculos.length) {
        caja.innerHTML = `<div class="sin-datos">📭 No se encontraron los vehículos guardados</div>`;
        return;
      }
      caja.innerHTML = vehiculos.map(v => {
        const fila = guardados.find(g => g.vehiculo_id === v.id);
        return `
          <div class="tarjeta-chica">
            <h3>${v.marca||''} ${v.modelo||''}</h3>
            <p>${v.anio||''} · ${v.ciudad||''}</p>
            <button class="quitar" onclick="quitarFavorito(${fila.id}, event)">🗑️ Quitar</button>
          </div>
        `;
      }).join('');
    }

    async function quitarFavorito(idFila, evento) {
      if (!confirm('¿Quitar de favoritos?')) return;
      evento.stopPropagation();
      const sb = await getSupabase();
      const { error } = await sb.from('mis_vehiculos').delete().eq('id', idFila);
      if (error) {
        alert('❌ No se pudo quitar: ' + error.message);
        return;
      }
      await cargarFavoritos();
    }

    function verDetalle(id) {
      // Cambiá el nombre acá si tu archivo se llama distinto
      window.location.href = 'ver-vehiculo.html?id=' + id;
    }

    async function iniciar() {
      const ok = await verificarSesion();
      if (!ok) return;
      await cargarPublicados();
      await cargarFavoritos();
    }

    iniciar();
  </script>
</body>
</html>
